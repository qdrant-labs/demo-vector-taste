# secrets — first entry, before .env.example exists, because this repo is public
.env
.env.local
*.key

# corpus audio and models are fetched, never committed
audio/
models/
qdrant_storage/
cache/
raw/

# generated artifacts
timings.jsonl
*.wav
*.mp3
*.flac
!tests/fixtures/*.wav

# The pre-baked generation bank IS committed (~5.5MB per track). It is our own model
# output, it makes `git clone && uv sync && vt ui` a working demo with real audio, and it
# is the stage path — a demo that depends on downloading a release bundle is a demo that
# depends on the network. Corpus audio stays out: that is other people's music, fetched
# by a script under its own licence.
!bank/*.wav

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# os / editor
.DS_Store
.idea/
.vscode/
.acestep

# Live generations: one file per take, regenerated on demand. The curated bank/ is
# committed; these are not.
generated/
