# secrets — first entry, before .env.example exists, because this repo is public
.env
.env.local
*.key

# corpus audio and models are fetched, never committed
audio/
models/
qdrant_storage/
cache/
raw/

# generated artifacts
timings.jsonl
*.wav
*.mp3
*.flac
!tests/fixtures/*.wav


# Written by ingest for ad-hoc analysis and read by nothing. 5.9MB at 1,005 tracks, ~53MB at
# 8,780 -- past GitHub's warning threshold, and a fresh blob on every re-ingest.
data/embeddings.npy

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# os / editor
.DS_Store
.idea/
.vscode/
.acestep

# Live generations: one file per take, regenerated on demand. Never committed.
generated/

# User-supplied audio of unknown licence. *.mp3/*.wav/*.flac are already ignored above;
# this is belt-and-braces on someone else's music. Purged on every server start anyway.
uploads/

# Taste profiles are written on every compose while exploring, so ignore them by
# default and track ONLY the scripted demo set that `vt rehearse` depends on.
data/taste_*.json
data/prompt_*.json
!data/taste_lofi.json
!data/taste_electronic.json
!data/taste_acoustic.json
