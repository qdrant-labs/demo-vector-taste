# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Qdrant -----------------------------------------------------------------
# Leave both unset to use the local container from scripts/qdrant_up.sh.
# Set both to point at your own Qdrant Cloud cluster instead.
# QDRANT_URL=https://xxxxxxxx.us-east-0-1.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=

# If you started the local container on a non-default port:
# QDRANT_URL=http://localhost:6343

# --- Generation backend -----------------------------------------------------
# There is deliberately NO fallback: a backend that fails raises, and the UI says
# why. Quietly serving something older made a broken generator indistinguishable
# from a working one.
#
# elevenlabs = hosted ElevenLabs Music (default). ~4s per track, and the only
#             backend where a rejected example reaches the MODEL (negative_styles)
#             rather than only reshaping retrieval. Costs ~$0.075 per 30s track
#             (~$0.15 the first time a reference clip is uploaded -- uploads bill
#             as a generation, so we cache the song_id). Needs the network and a
#             key. Note the seed is not reproducible here.
# local     = compose with ACE-Step on this machine. Fully offline, but ~2-5 min
#             per track and a ~19GB memory footprint. Needs
#             ./scripts/acestep_setup.sh. Switch to this to run with no network.
# modal     = your Modal account
# replicate = your Replicate token
GEN_BACKEND=elevenlabs

# The UI toggle can pick elevenlabs per-compose regardless of the default above;
# it disables itself when this key is missing.
# Put the real value in .env.local, which is gitignored.
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=music_v2                 # conditioning requires v2
# ELEVENLABS_OUTPUT_FORMAT=mp3_48000_192
# ELEVENLABS_CONDITION_STRENGTH=medium      # low | medium | high

# REPLICATE_API_TOKEN=

# --- Optional: hosted embedder for comparison -------------------------------
# Only used with `--embedder=marengo`. CLAP is the default and needs no key.
# TWELVELABS_API_KEY=
